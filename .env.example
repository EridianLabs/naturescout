# Frontend keys only — never commit real secrets.
# Restrict MapTiler key HTTP origins to:
#   https://naturescout.co.uk
#   https://www.naturescout.co.uk
#   http://localhost:5173

VITE_MAPTILER_KEY=your_maptiler_key_here

# Optional — iNaturalist OAuth is only needed for posting as a user.
# Public observation reads work without these.
VITE_INATURALIST_APP_ID=
VITE_INATURALIST_APP_SECRET=

# Optional Geograph API key if you register one later
VITE_GEOGRAPH_API_KEY=
